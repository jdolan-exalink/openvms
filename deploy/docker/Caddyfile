# SITE_ADDRESS=":80" serves plain HTTP for local development.
# Set it to the public hostname (e.g. vms.example.com) and Caddy obtains a TLS certificate.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		# /docs loads the API reference renderer from jsdelivr; everything else is same-origin.
		# /docs loads the API reference renderer from jsdelivr; vector tiles, sprites and
		# glyphs come from OpenFreeMap (one host; a CSP wildcard does not match the bare
		# host, so OSM raster fallback keeps both spellings).
		Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' data: https://cdn.jsdelivr.net; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://tiles.openfreemap.org; connect-src 'self' ws: wss: https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://tiles.openfreemap.org; media-src 'self' blob:; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'"
		-Server
	}

	@api path /api/* /media/* /ws /ws/* /health/* /openapi.json /docs
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	handle {
		root * /srv

		# Everything except the content-hashed bundles (the service worker, its registration helper,
		# the manifest, icons and the SPA shell served for any route) is revalidated on every load
		# so a new deploy is noticed; hashed assets never change.
		@revalidate not path /assets/*
		header @revalidate Cache-Control "no-cache"

		@webmanifest path /manifest.webmanifest
		header @webmanifest Content-Type "application/manifest+json"

		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
