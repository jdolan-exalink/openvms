# SITE_ADDRESS=:80 keeps the existing local HTTP listener.
# The separately configured HTTPS listener is available on host port 8443 and
# uses a persisted self-signed certificate for the configured HTTPS SAN set.
{
	auto_https disable_redirects
	servers {
		# Only operator-configured ingress proxy peers may assert forwarded HTTPS.
		# The empty Compose default means no proxy peers are trusted.
		trusted_proxies static {$HTTPS_INGRESS_PROXY_CIDRS}
	}
	# IP-literal HTTPS clients omit SNI. Select the configured IP-SAN certificate
	# for those handshakes without weakening certificate verification.
	default_sni {$OPENVMS_HTTPS_DEFAULT_SNI:localhost}
}

(openvms_site_routes) {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options SAMEORIGIN
		# /docs loads the API reference renderer from jsdelivr; vector tiles, sprites and
		# glyphs come from OpenFreeMap (one host; a CSP wildcard does not match the bare
		# host, so OSM raster fallback keeps both spellings).
		Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' data: https://cdn.jsdelivr.net; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://tiles.openfreemap.org; connect-src 'self' ws: wss: https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://tiles.openfreemap.org; media-src 'self' blob:; frame-src 'self' blob:; manifest-src 'self'; worker-src 'self'; frame-ancestors 'self'"
		-Server
	}

	# Caddy's reverse_proxy normalizes forwarded headers. Reject comma-joined XFP
	# values first, before duplicate fields can be collapsed to a single value.
	@api_forwarded_proto_chain {
		path /api/* /media/* /ws /ws/* /health/* /openapi.json /docs
		expression `{http.request.header.X-Forwarded-Proto}.contains(",")`
	}
	handle @api_forwarded_proto_chain {
		respond "invalid forwarded protocol" 400
	}

	@api path /api/* /media/* /ws /ws/* /health/* /openapi.json /docs
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	@https_port_hint path /.well-known/openvms-https-port
	handle @https_port_hint {
		header Cache-Control no-store
		header Content-Type text/plain
		respond {$OPENVMS_WEB_HTTPS_PORT:8443} 200
	}

	handle {
		root * /srv

		# Everything except the content-hashed bundles (the service worker, its registration helper,
		# the manifest, icons and the SPA shell served for any route) is revalidated on every load
		# so a new deploy is noticed; hashed assets never change.
		@revalidate not path /assets/*
		header @revalidate Cache-Control "no-cache"

		@webmanifest path /manifest.webmanifest
		header @webmanifest Content-Type "application/manifest+json"

		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}

# Preserve HTTP :80 (host default 8000) for existing local workflows. It does not
# redirect; credentialed UI actions refuse to submit from this origin.
{$SITE_ADDRESS::80} {
	import openvms_site_routes
}

# TLS is restricted to modern protocol versions. The entrypoint provisions a leaf
# certificate for explicit configured SANs or validates an operator-supplied pair.
{$HTTPS_SITE_ADDRESS::443} {
	tls {$CADDY_TLS_CERT_FILE:/var/lib/openvms/tls/current/tls.crt} {$CADDY_TLS_KEY_FILE:/var/lib/openvms/tls/current/tls.key} {
		protocols tls1.2 tls1.3
	}
	import openvms_site_routes
}
