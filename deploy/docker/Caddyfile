# SITE_ADDRESS=:80 keeps the existing local HTTP listener.
# The separately configured HTTPS listener is available on host port 8443 and
# uses the operator-bootstrapped certificate for HTTPS_SITE_ADDRESS.
{
	auto_https disable_redirects
	# IP-literal HTTPS clients omit SNI. Select the configured IP-SAN certificate
	# for those handshakes without weakening certificate verification.
	default_sni {$HTTPS_SITE_ADDRESS:10.1.1.24}
}

(openvms_site_routes) {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		# /docs loads the API reference renderer from jsdelivr; vector tiles, sprites and
		# glyphs come from OpenFreeMap (one host; a CSP wildcard does not match the bare
		# host, so OSM raster fallback keeps both spellings).
		Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' data: https://cdn.jsdelivr.net; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://tiles.openfreemap.org; connect-src 'self' ws: wss: https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://tiles.openfreemap.org; media-src 'self' blob:; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'"
		-Server
	}

	@api path /api/* /media/* /ws /ws/* /health/* /openapi.json /docs
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	handle {
		root * /srv

		# Everything except the content-hashed bundles (the service worker, its registration helper,
		# the manifest, icons and the SPA shell served for any route) is revalidated on every load
		# so a new deploy is noticed; hashed assets never change.
		@revalidate not path /assets/*
		header @revalidate Cache-Control "no-cache"

		@webmanifest path /manifest.webmanifest
		header @webmanifest Content-Type "application/manifest+json"

		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}

# Preserve HTTP :80 (host default 8000) for existing local workflows. It does not
# redirect; credentialed UI actions refuse to submit from this origin.
{$SITE_ADDRESS::80} {
	import openvms_site_routes
}

# Manual TLS prevents Caddy from creating certificates or redirecting the HTTP site.
# The explicit self-signed/IP-SAN cert must be provisioned out of band and trusted by
# the operator's browser. TLS is restricted to modern protocol versions.
{$HTTPS_SITE_ADDRESS:10.1.1.24}:443 {
	tls /etc/caddy/tls.crt /etc/caddy/tls.key {
		protocols tls1.2 tls1.3
	}
	import openvms_site_routes
}
