# Copy to .env to override docker-compose defaults. Never commit real secrets.
POSTGRES_PASSWORD=openvms
LOG_LEVEL=info
# Public hostname; Caddy fetches a TLS certificate for it. ":80" = plain HTTP for local use.
SITE_ADDRESS=:80
WEB_PORT=8000
# Enable tracing export, e.g. http://otel-collector:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Primer administrador de plataforma. Se crea solo en una instalación nueva (nunca pisa uno existente).
# CAMBIAR la contraseña por defecto: es pública. Si queda "openvms123" se obliga a cambiarla al primer ingreso.
OPENVMS_ADMIN_USERNAME=admin
OPENVMS_ADMIN_PASSWORD=openvms123

# Organización y sitio iniciales. Se crean solo si la instalación no tiene ninguna organización.
OPENVMS_DEFAULT_TENANT=openvms
OPENVMS_DEFAULT_SITE=Sitio principal
