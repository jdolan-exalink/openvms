# Copy to .env to override docker-compose defaults. Never commit real secrets.
POSTGRES_PASSWORD=openvms
LOG_LEVEL=info
# Public hostname; Caddy fetches a TLS certificate for it. ":80" = plain HTTP for local use.
SITE_ADDRESS=:80
WEB_PORT=8000
# Enable tracing export, e.g. http://otel-collector:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=
